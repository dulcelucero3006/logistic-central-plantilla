# Copia este archivo como .env.local y llena los valores de tu proyecto.
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Solo para el servidor (Vercel). NUNCA le pongas el prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Opcional: sincronización con Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU-DOMINIO.vercel.app/api/google/callback
